MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net
MONGODB_DB=resiliencesoft_ai
EMBED_MODEL=BAAI/bge-small-en-v1.5

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
NIM_API_KEY=
NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
NIM_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
PROVIDER_ORDER=groq,nim,gemini

# JSON map: site_key -> {site_id, origins[], scopes[]}
SITES_JSON={"resiliencesoft-public":{"site_id":"resiliencesoft","origins":["https://www.resiliencesoft.com"],"scopes":["public"]}}
RATE_LIMIT_RPM=30
